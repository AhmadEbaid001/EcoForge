# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- secrets: never commit ---
.env
*.key
secrets/

# --- generated data (regenerate with scripts/, do not version) ---
data/ground_truth.csv
data/*.parquet

# data/buildings.geojson is deliberately NOT ignored, and the reason took a CI run
# to find. There are two generators: fetch_osm_buildings.py uses real OpenStreetMap
# footprints, gen_buildings.py draws synthetic squares offline. They produce
# different portfolios, and every number in the paper was measured on the OSM one.
# While the fixture was unversioned, a fresh clone regenerated the synthetic
# portfolio and the claims harness then re-measured the paper's claims against a
# system the paper does not describe - silently, and passing. It is 76 KB.
artifacts/
models/
out/

# --- infrastructure state ---
pgdata/
mosquitto/data/
mosquitto/log/
grafana/data/
integrity_anchor.log

# --- internal working notes, not part of the platform ---
# These are the team's engineering record - traps, decisions, the corrections the
# paper depends on - and they are kept on disk and read daily. They are not shipped:
# infra/Dockerfile copies only pyproject.toml, README.md, src/ and data/, and nginx
# serves web/, so none of them ever reached a container. Untracking them keeps the
# published repository to the platform itself.
CLAUDE.md
CLAUDE-DESIGN-BRIEF.md
HANDOFF.md
HANDOFF-UI-UX.md
SESSION-HANDOFF*.md
STITCH-PROMPT.md

# Design reference bundle: prototypes and generated fixture data, not the platform.
design_handoff_gemp/

# --- agent scratch ---
# .claude/ holds linked git worktrees: a full second copy of the tree, including
# a .env.example and a settings.local.json. Committing it would publish a
# duplicate of the repository inside itself.
.claude/

# --- OneDrive / Windows noise ---
Thumbs.db
desktop.ini
~$*

# --- Phase 1 generated infrastructure secrets ---
infra/mosquitto/passwd
anchor/*
!anchor/.gitkeep

# UCI dataset: 133 MB, downloadable, not versioned
data/household_power_consumption.txt

# Deploy state: which image is live and which one to go back to. Host-specific,
# and the rollback pointer must never be overwritten by a checkout.
.deploy/
reports/
