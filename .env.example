# Copy to .env and fill. .env is gitignored and must stay that way.

# Integrity signing key (F5). Injected as an env secret, never written to the
# database volume and never committed. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GEMP_HMAC_KEY=

# Database
GEMP_DB_HOST=timescaledb
GEMP_DB_PORT=5432
GEMP_DB_NAME=gemp
GEMP_DB_USER=gemp
GEMP_DB_PASSWORD=

# Read-only user for Grafana
GEMP_DB_RO_USER=gemp_ro
GEMP_DB_RO_PASSWORD=

# MQTT
GEMP_MQTT_HOST=mosquitto
GEMP_MQTT_PORT=1883
GEMP_MQTT_USER=gemp
GEMP_MQTT_PASSWORD=

# Simulation clock: 1 wall-second = SIM_SPEED data-seconds.
# 720 => 1 wall-second is 12 data-minutes. All rolling windows are evaluated in
# DATA time, never wall time (F6).
GEMP_SIM_SPEED=720

# --- alerting (F11), optional ---------------------------------------------
# Unset means no outbound notification at all, which is the demonstration default:
# nobody reads email or watches a chat channel during a presentation. Environment
# only - a notification target settable through the API is an exfiltration primitive.
GEMP_WEBHOOK_URL=
GEMP_WEBHOOK_MIN_SEVERITY=high

# --- sessions --------------------------------------------------------------
# Adds the Secure flag to session cookies, so they are never sent over plaintext.
# MUST be true for any deployment reachable over a network. It defaults to false
# because a Secure cookie is simply not sent over http://localhost, and the login
# would appear to work while every later request came back anonymous.
GEMP_COOKIE_SECURE=false

# Access is by account, not by shared secret. Create the first admin with:
#   python -m gemp.auth.bootstrap --username you
# There is no default account and no default password.
