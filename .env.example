# Copy to .env and fill. .env is gitignored and must stay that way.

# Integrity signing key (F5). Injected as an env secret, never written to the
# database volume and never committed. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GEMP_HMAC_KEY=

# Database
GEMP_DB_HOST=timescaledb
GEMP_DB_PORT=5432
GEMP_DB_NAME=gemp
GEMP_DB_USER=gemp
GEMP_DB_PASSWORD=

# Read-only database role. Nothing connects as it today - it exists because the
# archived Grafana provisioning under infra/grafana references it, and because a
# dashboard is a place someone eventually pastes an arbitrary query. See
# tests/test_grafana_archive.py: Grafana is NOT part of the five-container stack.
GEMP_DB_RO_USER=gemp_ro
GEMP_DB_RO_PASSWORD=

# MQTT
GEMP_MQTT_HOST=mosquitto
GEMP_MQTT_PORT=1883
GEMP_MQTT_USER=gemp
GEMP_MQTT_PASSWORD=

# Simulation clock: 1 wall-second = SIM_SPEED data-seconds.
# 720 => 1 wall-second is 12 data-minutes. All rolling windows are evaluated in
# DATA time, never wall time (F6).
GEMP_SIM_SPEED=720

# --- alerting (F11), optional ---------------------------------------------
# Unset means no outbound notification at all, which is the demonstration default:
# nobody reads email or watches a chat channel during a presentation. Environment
# only - a notification target settable through the API is an exfiltration primitive.
GEMP_WEBHOOK_URL=
GEMP_WEBHOOK_MIN_SEVERITY=high

# --- sessions --------------------------------------------------------------
# Adds the Secure flag to session cookies, so they are never sent over plaintext.
# MUST be true for any deployment reachable over a network. It defaults to false
# because a Secure cookie is simply not sent over http://localhost, and the login
# would appear to work while every later request came back anonymous.
GEMP_COOKIE_SECURE=false

# What address nginx publishes on. Loopback by default: the app is served over
# plaintext HTTP, so an interface open to the LAN hands any passive listener a
# replayable session cookie. To serve other devices set GEMP_HTTP_BIND=0.0.0.0
# AND GEMP_COOKIE_SECURE=true above - the Administration view reports the flag,
# so the pairing cannot silently disagree.
GEMP_HTTP_BIND=127.0.0.1
GEMP_HTTP_PORT=8080

# Access is by account, not by shared secret. Create the first admin with:
#   python -m gemp.auth.bootstrap --username you
# There is no default account and no default password.

# --- Judge Pass, optional --------------------------------------------------
# A one-day VIEWER account issued from a QR code on a card handed over at the
# booth. Every card carries the same code, so the limits live here: one pass per
# email, none after the closing time, at most DAILY_MAX in any 24 hours, and an
# off switch in Administration. Empty CODE means the feature is off.
# Generate the code with:
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
# The QR on the card then points at  <GEMP_PUBLIC_URL>/#/pass/<code>
GEMP_JUDGE_PASS_CODE=
# WITH a UTC offset, or passes stay off: 2026-09-14T23:59:59+03:00
GEMP_JUDGE_PASS_UNTIL=
GEMP_JUDGE_PASS_DAILY_MAX=90
# This deployment's public address; the pass email's sign-in button points here.
GEMP_PUBLIC_URL=

# The pass email. Unset means a judge is still signed in on the spot; only the
# email that lets them come back later is skipped. The first of these that is
# configured wins: Brevo's API, Resend's API, then plain SMTP over TLS.
GEMP_BREVO_API_KEY=
GEMP_RESEND_API_KEY=
# A Gmail mailbox: smtp.gmail.com, 587, the address, and an APP password
# (myaccount.google.com/apppasswords - needs 2-Step Verification on). The
# account's own password is refused by Gmail, and should never be put here.
GEMP_SMTP_HOST=
GEMP_SMTP_PORT=587
GEMP_SMTP_USER=
GEMP_SMTP_PASSWORD=
# "Name <address>". Over SMTP it defaults to GEMP_SMTP_USER; an API provider
# needs an address it has verified.
GEMP_MAIL_FROM=
GEMP_MAIL_REPLY_TO=
